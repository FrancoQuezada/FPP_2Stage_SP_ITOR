   author = {Jaime Carrasco and Rodrigo Mahaluf and ( U Chile and Fulgencio Lisón and David Palacios and Cristobal País and ( U Berkeley and Alejando Miranda},
   doi = {10.13140/RG.2.2.30435.22566},
   title = {Combining optimization and fire simulation modeling to protect biodiversity values at a landscape scale "Combining optimization and fire simulation modeling to protect biodiversity values at a landscape scale"},
